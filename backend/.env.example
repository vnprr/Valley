# Skopiuj do backend/.env (plik jest czytany niezależnie od katalogu startu uvicorna).
# Zmienne środowiskowe mają pierwszeństwo przed tym plikiem. Oba klucze są opcjonalne.

# --- Trasy, kawiarnie, geokodowanie: https://myprojects.geoapify.com ---
# Z kluczem: Geoapify Places + Route Matrix + Geocoding (plan darmowy: 3000 kredytów/dzień,
# jedno obliczenie dla 4 osób ≈ 129 kredytów). Bez klucza: migawka OSM + publiczny OSRM + Nominatim.
GEOAPIFY_API_KEY=

# --- AI: https://openrouter.ai/keys ---
# Bez klucza działa parser reguł (tylko proste polecenia).
# Uwaga: klucz może mieć własny limit wydatków (Settings -> Keys) — przy limicie $0
# płatne modele zwracają 403 nawet przy doładowanym koncie.
OPENROUTER_API_KEY=
# Model musi obsługiwać tool calling. Zmierzone na baterii 30 poleceń (tests/test_live.py):
# openai/gpt-4.1 90/90 (~0,0044 USD/polecenie), gpt-4.1-mini 29/30, gpt-4o-mini 28/30.
OPENROUTER_MODEL=openai/gpt-4.1

# --- Obliczenia ---
MAX_CANDIDATES=32          # ilu kawiarni dotyczy dokładna macierz czasów (koszt ≈ osoby × kandydaci)
ROUTE_CACHE_TTL_HOURS=24   # ważność zapisanych czasów tras
HTTP_TIMEOUT_S=20
OSRM_URL=https://routing.openstreetmap.de

# --- Aplikacja ---
DATABASE_URL=sqlite:///./common_ground.db
SEED_DEMO=true             # pusta baza -> spotkanie demo z nagranym wynikiem
# CORS_ORIGINS=["http://localhost:5173"]
